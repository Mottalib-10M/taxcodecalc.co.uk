---
/** Every page of `src/content/pages/` sits at /en/<slug>/ (a slug may hold one level: life-in-the-uk-test/practice). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() {
  return PAGES.map((page) => ({ params: { slug: page.en.slug }, props: { page } }));
}
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} />
