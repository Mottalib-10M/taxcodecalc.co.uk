---
/** Attributions required by the licences (RECETTE §12.1, rule 3). Shown at the foot of every page, embeds included. */
interface Props { class?: string }
const { class: cls = 'text-xs text-navy-500' } = Astro.props;
const OGL = 'https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/';
---
<p class={cls} data-licence-notice>
  Contains public sector information licensed under the <a class="underline" href={OGL} target="_blank" rel="noopener">Open Government Licence v3.0</a>: rates, thresholds, tax code rules and the PAYE calculation method published by HMRC and HM Treasury on GOV.UK, and the Scottish Government’s budget announcement; adapted and calculated by Radif Partners.
</p>
